---
// xdface Design System — design.xdface.net
---
<!DOCTYPE html>
<html lang="en" data-xd-theme="light-mono">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>xdface — Design system · Notepad</title>
  <meta name="description" content="One shared design system. Explore Light Mono, Light Color, Dark and Sepia across Notepad and xdface." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
  <link rel="stylesheet" href="/styles/global.css" />
  <script is:inline>
    (function () {
      var t = 'light-mono';
      try { t = localStorage.getItem('xd-theme') || t; } catch {}
      if (!['light-mono', 'light', 'dark', 'sepia'].includes(t)) t = 'light-mono';
      document.documentElement.setAttribute('data-xd-theme', t);
    })();
  </script>
  <style>
    .xd-code-block {
      position: relative;
      background: var(--xd-surface-2);
      border: 1px solid var(--xd-border);
      border-radius: var(--xd-radius-md);
      padding: 16px;
      font-family: var(--xd-font-mono);
      font-size: 13px;
      color: var(--xd-text-muted);
      line-height: 1.7;
      overflow-x: auto;
      margin-top: 20px;
    }
    .xd-code-block code {
      font-family: inherit;
      font-size: inherit;
    }
    .xd-code-block .xd-code-copy {
      position: absolute;
      top: 10px;
      right: 10px;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .xd-code-block:hover .xd-code-copy {
      opacity: 1;
    }
    .xd-code-block .xd-code-copy.copied {
      opacity: 1;
      color: var(--xd-success);
    }
    .xd-code-section-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--xd-text-muted);
      margin-bottom: 8px;
      margin-top: 24px;
    }
    .xd-code-block .kw  { color: var(--xd-badge); }
    .xd-code-block .str { color: var(--xd-link); }
    .xd-code-block .cm  { color: var(--xd-fg-3); font-style: italic; }
    .xd-code-block .attr { color: var(--xd-info); }
    .xd-code-block .val  { color: var(--xd-accent); }
  </style>
</head>
<body>

<!-- ══════════════════════════════════════════
     TOP NAV
══════════════════════════════════════════ -->
<nav class="showcase-nav" aria-label="Design system navigation">
  <div class="showcase-nav-inner">
    <a class="showcase-brand" href="#" aria-label="xdface design, home">
      <img src="/logo-mark-transparent-light.svg" alt="" width="34" height="34" class="logo-light" />
      <img src="/logo-mark-transparent-dark.svg" alt="" width="34" height="34" class="logo-dark" />
      <img src="/logo-mark-transparent-light.svg" alt="" width="34" height="34" class="logo-sepia" />
      <span>xdface<span class="showcase-brand-dot">.</span></span><span class="showcase-brand-caption">design system</span>
    </a>
    <div class="showcase-nav-links">
      <a href="#themes" class="nav-link">Themes</a>
      <a href="#colors" class="nav-link nav-hide-sm">Colors</a>
      <a href="#components" class="nav-link nav-hide-sm">Components</a>
      <a href="#tokens" class="nav-link nav-hide-sm">Tokens</a>
      <label class="showcase-theme-select">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16"/></svg>
        <select id="theme-select" aria-label="Choose theme">
          <option value="light-mono">Light · Mono</option>
          <option value="light">Light · Color</option>
          <option value="dark">Dark</option>
          <option value="sepia">Sepia</option>
        </select>
      </label>
    </div>
  </div>
</nav>

<!-- ══════════════════════════════════════════
     HERO
══════════════════════════════════════════ -->
<main>
<section class="theme-hero" id="themes" aria-labelledby="hero-title">
  <div class="theme-hero-intro">
    <p class="hero-eyebrow"><span></span> XDFACE DESIGN SYSTEM <span class="hero-version">v0.4.0</span></p>
    <h1 id="hero-title">A little space.<br/><span>A clearer mind.</span></h1>
    <p class="hero-description">One calm space. Four ways to make it yours.<br class="hero-desktop-break"/> White paper, a darker space, or the warmth of sepia.</p>
    <div class="theme-choices" role="group" aria-label="Choose a theme">
      <button type="button" class="theme-choice" data-theme-choice="light-mono" aria-pressed="true">
        <span class="choice-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" stroke="none"/></svg><span class="choice-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span></span>
        <strong>Light · Mono</strong><span>Just ink, paper &amp; your ideas.</span>
      </button>
      <button type="button" class="theme-choice" data-theme-choice="light" aria-pressed="false">
        <span class="choice-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18h1.5a2 2 0 0 0 1.4-3.4 1.7 1.7 0 0 1 1.2-2.9H18a3 3 0 0 0 3-3A9 9 0 0 0 12 3Z"/><circle cx="7.5" cy="10" r=".8"/><circle cx="11" cy="7" r=".8"/><circle cx="15.5" cy="8" r=".8"/></svg><span class="choice-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span></span>
        <strong>Light · Color</strong><span>White paper. A familiar spark.</span>
      </button>
      <button type="button" class="theme-choice" data-theme-choice="dark" aria-pressed="false">
        <span class="choice-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg><span class="choice-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span></span>
        <strong>Dark</strong><span>A softer light after hours.</span>
      </button>
      <button type="button" class="theme-choice" data-theme-choice="sepia" aria-pressed="false">
        <span class="choice-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 7v14M3 4h4a5 5 0 0 1 5 3 5 5 0 0 1 5-3h4v14h-4a5 5 0 0 0-5 3 5 5 0 0 0-5-3H3Z"/></svg><span class="choice-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span></span>
        <strong>Sepia</strong><span>Warm paper. An unhurried read.</span>
      </button>
    </div>
    <p class="hero-brand-note">Four themes. The same colorful smile.</p>
  </div>
  <div class="notepad-preview-wrap">
    <div class="notepad-preview" aria-label="Notepad preview in the selected theme">
      <div class="preview-topline"><span class="preview-window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>notepad.xdface.net</span><span class="preview-local">local</span></div>
      <div class="preview-workspace">
        <aside class="preview-sidebar">
          <div class="preview-brand"><img src="/logo-mark-transparent-light.svg" alt="" width="28" height="28" class="logo-light"/><img src="/logo-mark-transparent-dark.svg" alt="" width="28" height="28" class="logo-dark"/><img src="/logo-mark-transparent-light.svg" alt="" width="28" height="28" class="logo-sepia"/><strong>notepad<span>.</span></strong></div>
          <div class="preview-new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>New note<span>⌥ N</span></div>
          <p class="preview-list-label">YOUR NOTES <span>3</span></p>
          <div class="preview-note selected"><strong>A place to think</strong><span>Make room for what matters.</span><small>Just now</small></div>
          <div class="preview-note"><strong>Small observations</strong><span>Good ideas start small.</span><small>Yesterday</small></div>
          <div class="preview-note"><strong>Things to make</strong><span>A few things worth trying.</span><small>Oct 21</small></div>
          <p class="preview-sidebar-footer"><span class="status-indicator"></span>Saved in this browser</p>
        </aside>
        <div class="preview-document">
          <div class="preview-doc-breadcrumb">My space <span>/</span> A place to think</div>
          <div class="preview-doc-content"><p class="preview-doc-eyebrow">A LITTLE SPACE FOR YOUR IDEAS</p><h2>A place to think<span>.</span></h2><p>Every good idea starts with a little room.</p><p>No rush. No noise. Just a blank page and whatever is on your mind.</p><h3>Keep it simple</h3><ul><li>Write something worth remembering.</li><li>Let one idea lead to another.</li><li>Make a little space for yourself.</li></ul><blockquote>Less around you.<br/>More room for you.</blockquote><div class="preview-doc-rule"></div><div class="preview-saved"><span class="status-indicator"></span>All changes saved<span>Markdown</span></div></div>
        </div>
      </div>
    </div>
    <div class="preview-caption"><span><span class="status-indicator"></span> LIVE THEME PREVIEW</span><a href="https://notepad.xdface.net/" target="_blank" rel="noopener noreferrer">Open Notepad <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a></div>
  </div>
</section>
<div class="theme-principles"><span><strong>01</strong> Quiet surfaces</span><span><strong>02</strong> Thoughtful contrast</span><span><strong>03</strong> Color with intention</span><a href="#colors">Explore the system <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14m-5-5 5 5 5-5"/></svg></a></div>

<!-- ══════════════════════════════════════════
     COLORS
══════════════════════════════════════════ -->
<div id="colors" class="divider"></div>
<section class="section">
  <p class="section-label">Colors</p>
  <h2 class="section-title">Four themes. One shared language.</h2>
  <p class="section-desc">Buttons use solid <code style="font-family:var(--xd-font-mono);">--xd-action</code> with <code style="font-family:var(--xd-font-mono);">--xd-action-fg</code>. Choose white paper with monochrome or colorful details, forest surfaces in Dark, or warm paper in Sepia. The xdface logo keeps its color in every theme.</p>

  <div style="height:72px; border-radius: var(--xd-radius-lg); background: var(--xd-gradient-grin); margin-bottom:28px; display:flex; align-items:center; padding:0 24px; justify-content:space-between;">
    <span style="font-size:13px; font-weight:600; color:var(--xd-paper-50);">Grin gradient</span>
    <span class="token-pill copy-token" data-token="--xd-gradient-grin" style="background:color-mix(in srgb, var(--xd-paper-50) 20%, transparent); color:var(--xd-paper-50);">--xd-gradient-grin</span>
  </div>

  <div class="grid-4" style="margin-bottom:36px;">
    {[
      ['Action', '--xd-action', 'var(--xd-action)'],
      ['Action text', '--xd-action-fg', 'var(--xd-action-fg)'],
      ['Accent', '--xd-accent', 'var(--xd-accent)'],
      ['Link', '--xd-link', 'var(--xd-link)'],
      ['XP', '--xd-xp', 'var(--xd-xp)'],
      ['Streak', '--xd-streak', 'var(--xd-streak)'],
      ['Badge', '--xd-badge', 'var(--xd-badge)'],
      ['Info', '--xd-info', 'var(--xd-info)'],
      ['Mustard', '--xd-mustard', 'var(--xd-mustard)'],
      ['Surface', '--xd-surface', 'var(--xd-surface)'],
      ['Raised', '--xd-raised', 'var(--xd-raised)'],
      ['Background', '--xd-bg', 'var(--xd-bg)'],
    ].map(([name, token, color]) => (
      <div>
        <div style={`height:64px; border-radius:10px 10px 0 0; background:${color}; border:1px solid var(--xd-bd); border-bottom:none;`}></div>
        <div class="card" style="border-top:none; border-radius:0 0 10px 10px; padding:12px;">
          <p style="font-size:13px; font-weight:600; color:var(--xd-text);">{name}</p>
          <p class="token-pill copy-token" data-token={token} style="margin-top:4px; display:inline-block;">{token}</p>
        </div>
      </div>
    ))}
  </div>

  <p style="font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--xd-text-muted); margin-bottom:16px;">Book spines</p>
  <div style="display:flex; align-items:flex-end; gap:8px; padding:18px 18px 0; margin-bottom:36px; background:var(--xd-raised); border-bottom:10px solid var(--xd-bd-2); border-radius:12px 12px 0 0; overflow-x:auto;">
    {[
      ['hoja', '148px'], ['mandarina', '168px'], ['mostaza', '132px'], ['tinta', '176px'],
      ['rosa', '144px'], ['cielo', '156px'], ['pino', '170px'], ['durazno', '136px'],
      ['menta', '162px'], ['ciruela', '150px'],
    ].map(([name, height]) => (
      <div style={`height:${height}; min-width:42px; border-radius:6px 6px 0 0; background:var(--xd-spine-${name}); color:var(--xd-spine-${name}-fg); writing-mode:vertical-rl; transform:rotate(180deg); display:flex; align-items:center; justify-content:center; font-family:var(--xd-font-display); font-size:13px; padding:10px 0;`}>{name}</div>
    ))}
  </div>

  <div class="card" style="overflow:hidden;">
    <div style="min-height:120px; background: var(--xd-chrome); display:flex; align-items:center; padding:24px; gap:16px; border-bottom:1px solid var(--xd-bd);">
      <img src="/logo-mark-transparent-light.svg" alt="" width="40" height="40" class="logo-light" style="border-radius:10px;" />
      <img src="/logo-mark-transparent-dark.svg" alt="" width="40" height="40" class="logo-dark" style="border-radius:10px;" />
      <img src="/logo-mark-transparent-light.svg" alt="" width="40" height="40" class="logo-sepia" style="border-radius:10px;" />
      <div>
        <p style="font-family:var(--xd-font-display); font-size:22px; color:var(--xd-fg);">xdface</p>
        <p style="font-size:12px; color:var(--xd-fg-3);">Theme chrome follows data-xd-theme</p>
      </div>
    </div>
    <div style="padding:16px 24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
      <p style="font-size:13px; color:var(--xd-text-muted);">Header and sidebar surface</p>
      <span class="token-pill copy-token" data-token="--xd-chrome">--xd-chrome</span>
    </div>
  </div>
</section>


<div id="type" class="divider"></div>
<section class="section">
  <p class="section-label">Typography</p>
  <h2 class="section-title">Type scale</h2>
  <p class="section-desc">Fraunces for display, DM Sans for UI, Caveat for notes, DM Mono for code. Apps self-host the WOFF2 subsets.</p>

  <div class="card" style="padding:32px; margin-bottom:24px;">
    <div style="display:flex; flex-direction:column; gap:24px;">
      <div style="display:flex; align-items:baseline; gap:20px; flex-wrap:wrap;">
        <p class="type-display" style="font-family:var(--xd-font-display); font-size:48px; font-weight:650; letter-spacing:-0.03em; color:var(--xd-text); line-height:1;">Display</p>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <span class="token-pill">48px</span>
          <span class="token-pill">weight 800</span>
          <span class="token-pill">tracking -0.03em</span>
        </div>
      </div>
      <div style="display:flex; align-items:baseline; gap:20px; flex-wrap:wrap;">
        <p style="font-family:var(--xd-font-display); font-size:32px; font-weight:650; letter-spacing:-0.02em; color:var(--xd-text); line-height:1;">Heading 1</p>
        <div style="display:flex; gap:8px;"><span class="token-pill">32px</span><span class="token-pill">weight 700</span></div>
      </div>
      <div style="display:flex; align-items:baseline; gap:20px; flex-wrap:wrap;">
        <p style="font-family:var(--xd-font-display); font-size:24px; font-weight:650; letter-spacing:-0.015em; color:var(--xd-text); line-height:1;">Heading 2</p>
        <div style="display:flex; gap:8px;"><span class="token-pill">24px</span><span class="token-pill">weight 700</span></div>
      </div>
      <div style="display:flex; align-items:baseline; gap:20px; flex-wrap:wrap;">
        <p style="font-size:17px; font-weight:400; color:var(--xd-text); line-height:1.7;">Body — DM Sans 17px, line-height 1.7. Used for lesson prose and content areas.</p>
        <div style="display:flex; gap:8px;"><span class="token-pill">17px</span><span class="token-pill">weight 400</span></div>
      </div>
      <div style="display:flex; align-items:baseline; gap:20px; flex-wrap:wrap;">
        <p style="font-size:13px; font-weight:400; color:var(--xd-text-muted); line-height:1.5;">Caption / muted — 13px, color: text-muted</p>
        <div style="display:flex; gap:8px;"><span class="token-pill">13px</span><span class="token-pill">muted</span></div>
      </div>
      <div style="display:flex; align-items:baseline; gap:20px; flex-wrap:wrap;">
        <p style="font-family:var(--xd-font-mono); font-size:14px; color:var(--xd-link); line-height:1;">const action = tokens.gradient.action</p>
        <div style="display:flex; gap:8px;"><span class="token-pill">DM Mono</span><span class="token-pill">14px</span></div>
      </div>
      <div style="display:flex; align-items:baseline; gap:20px; flex-wrap:wrap;">
        <p style="font-family:var(--xd-font-hand); font-size:32px; color:var(--xd-accent); line-height:1;">a handwritten margin note</p>
        <div style="display:flex; gap:8px;"><span class="token-pill">--xd-font-hand</span><span class="token-pill">Caveat</span></div>
      </div>
    </div>
  </div>

  <div class="card" style="padding:32px; text-align:center;">
    <p style="font-size:40px; font-weight:800; letter-spacing:-0.03em;" class="gradient-text">Learn · Build · Ship</p>
    <p style="font-size:13px; color:var(--xd-text-muted); margin-top:12px;">
      Gradient text via <code style="font-family:var(--xd-font-mono); font-size:12px; background:var(--xd-surface-2); padding:2px 6px; border-radius:5px;">.gradient-text</code> utility
    </p>
  </div>
</section>


<!-- ══════════════════════════════════════════
     COMPONENTS
══════════════════════════════════════════ -->
<div id="components" class="divider"></div>
<section class="section">
  <p class="section-label">Components</p>
  <h2 class="section-title">Buttons & badges</h2>
  <p class="section-desc">Complete button system — variants, sizes, states, and special types.</p>

  <!-- Action buttons + sizes -->
  <div class="card" style="padding:32px; margin-bottom:16px;">
    <p style="font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--xd-text-muted); margin-bottom:20px;">Action buttons</p>
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:16px;">
      <button class="xd-btn-action xd-btn-sm">Small</button>
      <button class="xd-btn-action">Default</button>
      <button class="xd-btn-action xd-btn-lg">Large</button>
      <button class="xd-btn-action" disabled>Disabled</button>
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
      <span class="token-pill">.xd-btn-action</span>
      <span class="token-pill">.xd-btn-sm</span>
      <span class="token-pill">.xd-btn-lg</span>
    </div>
  </div>

  <!-- Ghost + subtle -->
  <div class="card" style="padding:32px; margin-bottom:16px;">
    <p style="font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--xd-text-muted); margin-bottom:20px;">Ghost & subtle</p>
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:16px;">
      <button class="xd-btn-ghost">Cancelar</button>
      <button class="xd-btn-ghost">Ver más</button>
      <button class="xd-btn-subtle">Opciones</button>
      <button class="xd-btn-subtle" style="color:var(--xd-xp); background:color-mix(in srgb, var(--xd-xp) 12%, transparent); border-color:color-mix(in srgb, var(--xd-xp) 28%, transparent);">+50 XP</button>
      <button class="xd-btn-subtle" style="color:var(--xd-badge); background:color-mix(in srgb, var(--xd-badge) 12%, transparent); border-color:color-mix(in srgb, var(--xd-badge) 28%, transparent);">Logro</button>
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
      <span class="token-pill">.xd-btn-ghost</span>
      <span class="token-pill">.xd-btn-subtle</span>
    </div>
  </div>

  <!-- Danger + loading + icon + full -->
  <div class="card" style="padding:32px; margin-bottom:24px;">
    <p style="font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--xd-text-muted); margin-bottom:20px;">Special variants</p>
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:16px;">
      <button class="xd-btn-danger">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
        Eliminar
      </button>
      <button class="xd-btn-loading">Guardando…</button>
      <button class="xd-btn-icon" title="Editar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </button>
      <button class="xd-btn-icon" title="Configuración">
