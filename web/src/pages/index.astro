      {[
        { label: 'sm',   radius: '8px',    size: 40 },
        { label: 'md',   radius: '12px',   size: 52 },
        { label: 'lg',   radius: '16px',   size: 64 },
        { label: 'xl',   radius: '20px',   size: 76 },
        { label: '2xl',  radius: '28px',   size: 84 },
        { label: 'full', radius: '9999px', size: 52 },
      ].map(r => (
        <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">
