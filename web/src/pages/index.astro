  <p class="section-desc" style="margin-top:6px;">Neutral shadows keep both light themes on a clean white canvas. <code style="font-family:var(--xd-font-mono);">--xd-soft-shadow-*</code> follows the selected theme.</p>

  <div class="grid-3" style="margin-bottom:40px;">
    <div class="card" style="padding:28px; display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center;">
      <div style="width:48px; height:48px; border-radius:12px; background:var(--xd-surface); border:1px solid var(--xd-bd); box-shadow: var(--xd-shadow-paper-sm);"></div>
      <div>
        <p style="font-size:13px; font-weight:600; color:var(--xd-text); margin-bottom:4px;">Paper SM</p>
        <span class="token-pill copy-token" data-token="--xd-shadow-paper-sm">--xd-shadow-paper-sm</span>
      </div>
    </div>
    <div class="card" style="padding:28px; display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center;">
      <div style="width:48px; height:48px; border-radius:12px; background:var(--xd-surface); border:1px solid var(--xd-bd); box-shadow: var(--xd-shadow-paper-md);"></div>
      <div>
        <p style="font-size:13px; font-weight:600; color:var(--xd-text); margin-bottom:4px;">Paper MD</p>
        <span class="token-pill copy-token" data-token="--xd-shadow-paper-md">--xd-shadow-paper-md</span>
      </div>
    </div>
    <div class="card" style="padding:28px; display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center;">
      <div style="width:48px; height:48px; border-radius:12px; background:var(--xd-surface); border:1px solid var(--xd-bd); box-shadow: var(--xd-shadow-paper-lg);"></div>
      <div>
        <p style="font-size:13px; font-weight:600; color:var(--xd-text); margin-bottom:4px;">Paper LG</p>
        <span class="token-pill copy-token" data-token="--xd-shadow-paper-lg">--xd-shadow-paper-lg</span>
      </div>
    </div>
  </div>

  <!-- Border radius scale -->
  <div>
    <p style="font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--xd-text-muted); margin-bottom:20px;">Border radius scale</p>
