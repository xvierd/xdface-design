<!-- ── Copy-to-clipboard for code blocks ── -->
<script>
  function copyCode(btn) {
    const block = btn.closest('.xd-code-block');
    const code = block.querySelector('code');
    const text = code.innerText;
    navigator.clipboard.writeText(text).then(() => {
      btn.classList.add('copied');
      btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copied';
      setTimeout(() => {
        btn.classList.remove('copied');
        btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy';
      }, 1800);
    });
  }
  window.copyCode = copyCode;
</script>

<!-- Theme choices share a single persisted source of truth. -->
<script>
  const themeSelect = document.querySelector<HTMLSelectElement>('#theme-select');
  const themeChoices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
  const themes = ['light-mono', 'light', 'dark', 'sepia'];
  function applyTheme(theme: string) {
    if (!themes.includes(theme)) return;
    document.documentElement.setAttribute('data-xd-theme', theme);
    if (themeSelect) themeSelect.value = theme;
    themeChoices.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme)));
  }
  function chooseTheme(theme: string) {
    applyTheme(theme);
    try { localStorage.setItem('xd-theme', theme); } catch {}
  }
  applyTheme(document.documentElement.getAttribute('data-xd-theme') || 'light-mono');
  themeSelect?.addEventListener('change', () => chooseTheme(themeSelect.value));
  themeChoices.forEach(button => button.addEventListener('click', () => chooseTheme(button.dataset.themeChoice!)));
</script>

<!-- ── Token pill: click-to-copy ── -->
<script>
  document.querySelectorAll('.copy-token').forEach(el => {
    const token = el.getAttribute('data-token');
    if (!token) return;
    el.setAttribute('title', 'Click to copy');
    el.style.cursor = 'pointer';
    el.addEventListener('click', () => {
      navigator.clipboard.writeText(token).then(() => {
        const prev = el.textContent;
        el.textContent = 'Copied!';
        el.style.color = 'var(--xd-link)';
        setTimeout(() => {
          el.textContent = prev;
          el.style.color = '';
        }, 1200);
      });
    });
  });
</script>

<!-- ── Motion demo: hover interactions ── -->
<script>
  // Duration boxes: click to animate across
  document.querySelectorAll('.motion-demo-box').forEach(box => {
    let toggled = false;
    box.addEventListener('click', () => {
      toggled = !toggled;
      box.style.transform = toggled ? 'translateX(60px)' : 'translateX(0)';
    });
  });

  // Easing boxes: click to animate
  document.querySelectorAll('.easing-demo-box').forEach(box => {
    let toggled = false;
    box.addEventListener('click', () => {
      toggled = !toggled;
      box.style.transform = toggled ? 'translateX(80px) rotate(180deg)' : 'translateX(0) rotate(0deg)';
    });
  });
</script>

