{
  "name": "@xdface/tokens",
  "version": "0.3.0",
  "description": "xdface Design System — Biblioteca personal divertida. CSS variables, TypeScript constants, and Tailwind preset",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xvierd/xdface-design"
  },
  "main": "./dist/tokens.js",
  "module": "./dist/tokens.mjs",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.js"
    },
    "./css": "./tokens.css",
    "./json": "./tokens.json",
    "./tailwind": "./tailwind.preset.js"
  },
  "files": [
    "dist",
    "tokens.css",
    "tokens.json",
    "tailwind.preset.js"
  ],
  "scripts": {
    "generate": "python3 build.py",
    "check:tokens": "python3 build.py --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "python3 build.py && tsup tokens.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
